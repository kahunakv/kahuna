<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test fixture, not a shipped component: it is the extension assembly the
       loader tests point at. It is never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kahuna.TestExtension</RootNamespace>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kahuna.Core\Kahuna.Core.csproj" />
  </ItemGroup>

</Project>
