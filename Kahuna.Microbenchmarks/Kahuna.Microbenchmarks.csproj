<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <IsPackable>false</IsPackable>
        <NoWarn>NU1903;CA1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="Google.Protobuf" Version="3.29.6" />
        <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
        <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- The batch-read decode benchmark measures the production message, the production payload
             helper and the production entry type rather than a stand-in for them. -->
        <ProjectReference Include="..\Kahuna.Core\Kahuna.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The stream-write benchmark hosts a real Kestrel gRPC echo server in-process. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
