[ req ]
default_md         = sha256
prompt             = no
distinguished_name = dn
x509_extensions    = ext

[ dn ]
O  = Kahuna Development
CN = kahuna3

[ ext ]
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName   = DNS:kahuna3, DNS:localhost, IP:172.30.0.4, IP:127.0.0.1
