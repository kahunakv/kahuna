FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
#FROM kahuna-base AS build-env

RUN rm -fr /src && mkdir -p /src
#COPY Kommander /src/Kommander/
COPY Kahuna.Shared /src/Kahuna.Shared/
COPY Kahuna.Core /src/Kahuna.Core/
COPY Kahuna.Server /src/Kahuna.Server/

# build the dotnet program
WORKDIR /

#RUN cd /src/Kahuna.Server/ && dotnet publish --no-self-contained --configuration Release -p:PublishReadyToRun=true -p:RunAnalyzers=false -o /app
RUN cd /src/Kahuna.Server/ && dotnet publish --no-self-contained --configuration Release -p:RunAnalyzers=false -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# expose the ports
EXPOSE 2070
EXPOSE 2071
EXPOSE 2072

# copy the built program
COPY --from=build-env /app .
COPY certs/development-certificate.pfx /app/certificate.pfx

# install sqlite to debug
# RUN apt -y update && apt -y upgrade && apt-get -y install sqlite3

ARG KAHUNA_RAFT_NODENAME
ARG KAHUNA_RAFT_NODEID
ARG KAHUNA_RAFT_HOST
ARG KAHUNA_RAFT_PORT
ARG KAHUNA_HTTP_PORTS
ARG KAHUNA_HTTPS_PORTS
ARG KAHUNA_GRPC_CLEARTEXT_PORTS
ARG KAHUNA_INITIAL_CLUSTER
ARG KAHUNA_RAFT_SCHEME="https://"

ENV DOTNET_SYSTEM_NET_SOCKETS_INLINE_COMPLETIONS=1
ENV KAHUNA_RAFT_NODENAME="$KAHUNA_RAFT_NODENAME"
ENV KAHUNA_RAFT_NODEID="$KAHUNA_RAFT_NODEID"
ENV KAHUNA_RAFT_HOST="$KAHUNA_RAFT_HOST"
ENV KAHUNA_RAFT_PORT="$KAHUNA_RAFT_PORT"
ENV KAHUNA_HTTP_PORTS="$KAHUNA_HTTP_PORTS"
ENV KAHUNA_HTTPS_PORTS="$KAHUNA_HTTPS_PORTS"
ENV KAHUNA_GRPC_CLEARTEXT_PORTS="$KAHUNA_GRPC_CLEARTEXT_PORTS"
ENV KAHUNA_INITIAL_CLUSTER="$KAHUNA_INITIAL_CLUSTER"
ENV KAHUNA_RAFT_SCHEME="$KAHUNA_RAFT_SCHEME"

# Extra server flags, appended verbatim to the command line and word-split by the shell. Empty by default,
# so a stock cluster is byte-for-byte what it was. Set it per service in the compose file (a runtime
# environment variable, so changing it needs only a container restart, not an image rebuild) to exercise
# behaviour that is off by default — e.g. KAHUNA_EXTRA_ARGS="--max-concurrent-sessions 1" to make the
# transaction admission gate reachable.
ENV KAHUNA_EXTRA_ARGS=""

# The heredoc delimiter is quoted so BuildKit does not expand these variables while baking the script.
# Left unquoted, every value is frozen at build time — which silently pins KAHUNA_EXTRA_ARGS to whatever
# it was during the build (empty), making it look like a runtime knob that does nothing. Quoted, the
# script keeps the variable references and the shell resolves them from the image's ENV at startup, so
# overriding one in compose takes effect on a container restart with no rebuild.
COPY --chmod=755 <<'EOT' /app/entrypoint.sh
#!/usr/bin/env bash

mkdir -p /storage/data
mkdir -p /storage/wal

# The cleartext HTTP/2 flag is only valid with a value; when the variable is empty, omit the
# flag entirely so the command-line parser does not see a bare option.
H2C_ARGS=""
if [ -n "$KAHUNA_GRPC_CLEARTEXT_PORTS" ]; then
    H2C_ARGS="--grpc-cleartext-ports $KAHUNA_GRPC_CLEARTEXT_PORTS"
fi

echo "kahuna --raft-nodename $KAHUNA_RAFT_NODENAME --raft-nodeid $KAHUNA_RAFT_NODEID --raft-host $KAHUNA_RAFT_HOST --raft-port $KAHUNA_RAFT_PORT --raft-grpc-scheme $KAHUNA_RAFT_SCHEME --http-ports $KAHUNA_HTTP_PORTS --https-ports $KAHUNA_HTTPS_PORTS $H2C_ARGS --https-certificate /app/certificate.pfx --initial-cluster $KAHUNA_INITIAL_CLUSTER --storage rocksdb --storage-path /storage/data --storage-revision v1 --wal-storage rocksdb --wal-path /storage/wal --wal-revision v3 --disable-wal-sync-writes --raft-allow-insecure-certificate-validation $KAHUNA_EXTRA_ARGS"

dotnet /app/Kahuna.Server.dll --raft-nodename $KAHUNA_RAFT_NODENAME --raft-nodeid $KAHUNA_RAFT_NODEID --raft-host $KAHUNA_RAFT_HOST --raft-port $KAHUNA_RAFT_PORT --raft-grpc-scheme $KAHUNA_RAFT_SCHEME --http-ports $KAHUNA_HTTP_PORTS --https-ports $KAHUNA_HTTPS_PORTS $H2C_ARGS --https-certificate /app/certificate.pfx --initial-cluster $KAHUNA_INITIAL_CLUSTER --storage rocksdb --storage-path /storage/data --storage-revision v1 --wal-storage rocksdb --wal-path /storage/wal --wal-revision v3 --disable-wal-sync-writes --raft-allow-insecure-certificate-validation $KAHUNA_EXTRA_ARGS
EOT

# when starting the container, run dotnet with the built dll
ENTRYPOINT [ "/app/entrypoint.sh" ]

# Swap entrypoints if the container is exploding and you want to keep it alive indefinitely so you can go look into it.
#ENTRYPOINT ["tail", "-f", "/dev/null"]
