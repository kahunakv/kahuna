<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <RootNamespace>Kahuna.Server</RootNamespace>
  <ServerGarbageCollection>true</ServerGarbageCollection>
  <InvariantGlobalization>true</InvariantGlobalization>
</PropertyGroup>

<!-- Ships as a .NET global tool: `dotnet tool install -g Kahuna.Server` then `kahuna-server`.
     The Web SDK disables packing by default, so IsPackable must be set explicitly. PackAsTool only
     adds targets under Pack, leaving build/run/publish (and therefore the Docker image) untouched.
     PackageId must live here rather than on the pack command line — as a global property it flows
     into the whole restore graph and collides with the referenced projects. -->
<PropertyGroup>
  <IsPackable>true</IsPackable>
  <PackAsTool>true</PackAsTool>
  <ToolCommandName>kahuna-server</ToolCommandName>
  <PackageId>Kahuna.Server</PackageId>
  <Version>1.6.0</Version>
  <Authors>Andres Gutierrez</Authors>
  <Company>Kahuna KV</Company>
  <Description>Kahuna server node — distributed key-value store, lock manager and sequencer. Run `kahuna-server` to start a standalone node.</Description>
  <PackageDescription>Kahuna server node — distributed key-value store, lock manager and sequencer. Run `kahuna-server` to start a standalone node.</PackageDescription>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <PackageProjectUrl>https://github.com/kahunakv/kahuna</PackageProjectUrl>
  <RepositoryUrl>https://github.com/kahunakv/kahuna</RepositoryUrl>
  <PackageTags>dotnet;kahuna;keyvalue;locks;raft;server;database</PackageTags>
  <PackageOutputPath>./nupkg</PackageOutputPath>
  <IncludeSymbols>false</IncludeSymbols>
</PropertyGroup>

<ItemGroup>
  <None Include="../README.md">
    <Pack>True</Pack>
    <PackagePath>\</PackagePath>
  </None>
</ItemGroup>

  <PropertyGroup>
    <NoWarn>SYSLIB0051</NoWarn>
  </PropertyGroup>

<ItemGroup>
  <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
  <PackageReference Include="CommandLineParser" Version="2.9.1" />
</ItemGroup>

<ItemGroup>
  <Folder Include="Cluster\" />
  <Folder Include="Communication\External\" />
</ItemGroup>

<!-- The operator dashboard's three assets, embedded rather than placed under wwwroot. This project
     ships as a .NET global tool; embedded resources travel with the assembly, so the tool, the
     container image and a plain `dotnet run` all serve the same bytes with no static-web-asset
     manifest to be absent at the wrong moment. The None Remove is required because the SDK's
     default globbing already claims these files, and an item cannot be both. LogicalName is set
     explicitly so a folder rename cannot silently change the resource name DashboardAssets asks
     for — that failure would only appear at the first request, not at build. -->
<ItemGroup>
  <None Remove="Dashboard\**" />
  <EmbeddedResource Include="Dashboard\index.html" LogicalName="Kahuna.Server.Dashboard.index.html" />
  <EmbeddedResource Include="Dashboard\dashboard.css" LogicalName="Kahuna.Server.Dashboard.dashboard.css" />
  <EmbeddedResource Include="Dashboard\dashboard.js" LogicalName="Kahuna.Server.Dashboard.dashboard.js" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kahuna.Core\Kahuna.Core.csproj" />
    <ProjectReference Include="..\Kahuna.Shared\Kahuna.Shared.csproj" />
  </ItemGroup>
  
</Project>
