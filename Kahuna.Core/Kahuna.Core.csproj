<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kahuna</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <IsPackable>true</IsPackable>
    <PackageId>Kahuna.Core</PackageId>
    <Version>1.9.10</Version>
    <Description>.NET embeddable core for Kahuna: Distributed locks, reliable key-value store and idempotent sequencer</Description>
    <Authors>Andres Gutierrez</Authors>
    <Company>Andres Gutierrez</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageDescription>.NET embeddable core for Kahuna: Distributed locks, reliable key-value store and idempotent sequencer</PackageDescription>
    <PackageProjectUrl>https://github.com/kahunakv/kahuna</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kahunakv/kahuna</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>distributed lock;locks;redlock;raft;consensus;paxos;distributed consensus;leader election;zookeeper</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>SYSLIB0051</NoWarn>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!--
    Thread-free build (KAHUNA_THREAD_FREE). The net10.0-browser target runs an embedded node on the
    default single-threaded browser-wasm runtime. It resolves the thread-free assembly of Kommander
    (KOMMANDER_THREAD_FREE), whose host pump replaces the worker threads.

    A default build does not define the symbol, so the net10.0 assembly compiles from the same code
    as before. The browser target leaves out everything the browser cannot load:
    - ASP.NET Core, which has no browser-wasm runtime pack (NETSDK1082), and the gRPC and REST
      server surface built on it;
    - the gRPC inter-node client, which needs SocketsHttpHandler;
    - the RocksDB and SQLite persistence backends, whose native libraries the browser does not have
      (the browser target of Kommander has no RocksDB or SQLite package either);
    - Blake3, whose native library has no browser-wasm build.
  -->
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-browser'))">
    <DefineConstants>$(DefineConstants);KAHUNA_THREAD_FREE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="!$(TargetFramework.EndsWith('-browser'))">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.EndsWith('-browser'))">
    <!-- The script parser pool. The default build gets it from the ASP.NET Core shared framework. -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
    <Compile Remove="Communication/InterNodeHeaders.cs" />
    <Compile Remove="Communication/NodeTransportGate.cs" />
    <Compile Remove="Communication/External/ClusterLeave.cs" />
    <Compile Remove="Communication/External/Grpc/**/*.cs" />
    <Compile Remove="Communication/InterNode/GrpcInterNodeCommunication.cs" />
    <Compile Remove="Communication/InterNode/Grpc/**/*.cs" />
    <Compile Remove="Persistence/Backend/RocksDbPersistenceBackend.cs" />
    <Compile Remove="Persistence/Backend/SqlitePersistenceBackend.cs" />
    <Compile Remove="Embedding/RaftWalTuningFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.6" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nixie" Version="1.3.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <PackageReference Include="YaccLexTools" Version="1.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ASP.NET host lives in its own assembly but is part of this component: its REST handlers
         are the transport half of the same request path the gRPC services here serve, and they need
         the routing-capture types those services use. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Server</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Server.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Client.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Microbenchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Replication\Protos\lock_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\keyvalue_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\rangemap_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\rangesnapshot_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\snapshotfloor_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\meta_system_state_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\coordinator_decision_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\transaction_record_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\prepared_intent_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Replication\Protos\partitionstate_message.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
    <Protobuf Include="Persistence\Protos\rocksdb.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kahuna.Shared\Kahuna.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Label="ScriptParser">
    <YaccFile Include="ScriptParser\ScriptParser.Language.grammar.y">
      <OutputFile>ScriptParser\ScriptParser.Parser.Generated.cs</OutputFile>
      <Arguments>/gplex /nolines</Arguments>
    </YaccFile>
    <None Include="ScriptParser\ScriptParser.Parser.Generated.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ScriptParser\ScriptParser.Language.grammar.y</DependentUpon>
    </None>
    <LexFile Include="ScriptParser\ScriptParser.Language.analyzer.lex">
      <OutputFile>ScriptParser\ScriptParser.Scanner.Generated.cs</OutputFile>
    </LexFile>
    <None Include="ScriptParser\ScriptParser.Scanner.Generated.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ScriptParser\ScriptParser.Language.analyzer.lex</DependentUpon>
    </None>
  </ItemGroup>

</Project>
