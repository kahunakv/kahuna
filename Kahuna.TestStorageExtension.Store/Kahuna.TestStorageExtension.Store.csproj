<Project Sdk="Microsoft.NET.Sdk">

  <!-- A test fixture, not a shipped component: the private dependency of the storage extension
       fixture. The server and the tests do not reference it, so the loader can only find it in the
       extension's own directory. It is never packed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kahuna.TestStorageExtension.Store</RootNamespace>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
